# Copy to .env (git-ignored). Every setting is optional.

# --- AI writer (optional) --------------------------------------------------
# Without a key, the template writer is used. The AI only rewords the resume and
# store explanations; it never decides issues or severity. Nothing is ever sent.
OPENAI_API_KEY=
GEMINI_API_KEY=
# auto | openai | gemini | off
PCHEALTH_LLM=auto
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# --- Paths -----------------------------------------------------------------
# PCHEALTH_VAR=var
# PCHEALTH_DB=var/health.db
# PCHEALTH_RULES=config/rules.toml

# Name shown next to "handled" notes
PCHEALTH_OPERATOR=operator
